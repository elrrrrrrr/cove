[
  {
    "trigger": {
      "url-filter": ".*",
      "resource-type": ["script", "image", "style-sheet", "media", "raw", "font", "document"],
      "if-domain": [
        "googlesyndication.com",
        "doubleclick.net",
        "googleadservices.com",
        "adservice.google.com",
        "ads.twitter.com",
        "static.ads-twitter.com",
        "facebook.com",
        "connect.facebook.net",
        "platform.twitter.com",
        "syndication.twitter.com",
        "ads.yahoo.com",
        "advertising.com",
        "adnxs.com",
        "taboola.com",
        "outbrain.com",
        "criteo.com",
        "quantserve.com",
        "scorecardresearch.com",
        "moatads.com",
        "rubiconproject.com",
        "pubmatic.com",
        "openx.net",
        "yieldmanager.com",
        "amazon-adsystem.com",
        "adsrvr.org",
        "smartadserver.com"
      ]
    },
    "action": {
      "type": "block"
    }
  },
  {
    "trigger": {
      "url-filter": "(ads|advertisement|banner|popup|tracker|tracking|analytics|pixel|beacon|telemetry)\\."
    },
    "action": {
      "type": "block"
    }
  },
  {
    "trigger": {
      "url-filter": ".*",
      "resource-type": ["script"],
      "url-filter-is-case-sensitive": false,
      "if-domain": [
        "googletagmanager.com",
        "google-analytics.com",
        "hotjar.com",
        "fullstory.com",
        "mixpanel.com",
        "amplitude.com",
        "segment.com",
        "heap.io",
        "clarity.ms"
      ]
    },
    "action": {
      "type": "block"
    }
  }
]
