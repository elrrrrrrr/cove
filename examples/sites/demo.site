schemaVersion: 2
id: example.media
name: 示例媒体
source:
  adapter: web
  url: https://media.example/
entries:
  - id: videos
    name: 视频
    path: /videos/
    kind: video
  - id: comics
    name: 漫画
    path: /books/
    kind: comic
modules:
  catalog:
    items: article.card
    kind: video
    fields:
      title: .title
      url: a@href
      thumbnail: img@src
      tags: .tag[]
    variants:
      - match: {pathPrefix: /books/}
        kind: comic
        items: article.book
        fields: {title: .title, url: a@href, thumbnail: img@src}
  pagination:
    next: 'a[rel=next]@href'
  search:
    url: '/search?q={query}'
  login:
    url: /login
  video:
    fields: {url: 'video@src'}
  comic:
    match: {pathPrefix: /book/}
    fields:
      title: h1
      chapters:
        selector: .chapters a
        all: true
        fields:
          title: {text: true}
          url: {attribute: href}
  chapter:
    match: {pathPrefix: /chapter/}
    fields: {images: 'img.page@src[]'}
presentation:
  layout: grid
  openItem: videoFeed
  feed:
    nextGesture: swipeUp
    autoplay: true
    preloadNext: 1
    onPlaybackEnd: stop
